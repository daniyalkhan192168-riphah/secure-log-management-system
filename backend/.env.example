# SecureLog backend settings - EXAMPLE ONLY (no real secrets).
# Do not edit this by hand: run  python manage.py init  to create the real backend\.env
# with a password hash, token secret and agent keys.

# Dashboard login
SECURELOG_ADMIN_USERNAME=admin
SECURELOG_ADMIN_PASSWORD_HASH=<created by manage.py set-password>
SECURELOG_TOKEN_SECRET=<random 64-character secret created by manage.py init>
SECURELOG_TOKEN_TTL_MINUTES=480

# Log agents (name:sha256-of-key, comma separated) - created by manage.py add-agent
SECURELOG_AGENT_KEYS=<agent-name>:<sha256-of-agent-key>

# Web settings
SECURELOG_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SECURELOG_DEMO_MODE=false
SECURELOG_ENABLE_DOCS=true
